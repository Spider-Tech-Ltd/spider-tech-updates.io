# ==============================================================================
# Spider Tech Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Paystack Gateway Configuration
# Get your keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN
PAYSTACK_TIMEOUT_SECONDS=30
PAYSTACK_VERIFY_SSL=true
# Optional: Path to custom CA certificate bundle (auto-detected on Windows/XAMPP if omitted)
# PAYSTACK_CA_BUNDLE=config/cacert.pem

# Invoice & Receipt Link Security Secret (Used to sign printable receipt access tokens)
RECEIPT_LINK_SECRET=spider_tech_receipt_secure_secret_change_in_production
INVOICE_HASH_SALT=spider_tech_invoice_secure_salt_change_in_production

# Central Company / Invoice Issuer Details
INVOICE_COMPANY_NAME="Spider Technologies Limited"
INVOICE_COMPANY_ADDRESS="Flat 3, Left Wing, Abinsa House, Zaria Road, Kano"
INVOICE_COMPANY_EMAIL="info@spidertech.com.ng"
INVOICE_COMPANY_PHONE="+234 911 626 5708"
INVOICE_COMPANY_WEBSITE="www.spidertech.com.ng"

# Mailer Settings (Optional overrides for SMTP)
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USER=your_user
# MAIL_PASS=your_pass
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=admissions@spidertech.com.ng
# MAIL_FROM_NAME="Spider Tech Admissions"
