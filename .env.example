# ==============================================================================
# Spider Tech Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Paystack Gateway Configuration
# Get your keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN
PAYSTACK_TIMEOUT_SECONDS=30
PAYSTACK_VERIFY_SSL=true

# Invoice Security Salt (Used to sign printable invoice access tokens)
INVOICE_HASH_SALT=spider_tech_invoice_secure_salt_change_in_production

# Mailer Settings (Optional overrides for SMTP)
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USER=your_user
# MAIL_PASS=your_pass
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=admissions@spidertech.com.ng
# MAIL_FROM_NAME="Spider Tech Admissions"
